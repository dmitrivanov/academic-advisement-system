<p class="p2"><br></p>
<p class="p1">function getSelectedMajorCode() {</p>
<p class="p1"><span class="Apple-converted-space">  </span>return document.querySelector('input[name="major"]:checked').value;</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function getSelectedMajor() {</p>
<p class="p1"><span class="Apple-converted-space">  </span>return MAJORS[getSelectedMajorCode()];</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function getCompletedCourses() {</p>
<p class="p1"><span class="Apple-converted-space">  </span>const checked = document.querySelectorAll(".completed-check:checked");</p>
<p class="p1"><span class="Apple-converted-space">  </span>return new Set([...checked].map(cb =&gt; cb.value));</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function prereqSatisfied(prereq, completed) {</p>
<p class="p1"><span class="Apple-converted-space">  </span>if (Array.isArray(prereq)) {</p>
<p class="p1"><span class="Apple-converted-space">    </span>return prereq.some(option =&gt; completed.has(option));</p>
<p class="p1"><span class="Apple-converted-space">  </span>}</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>return completed.has(prereq);</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function allPrereqsSatisfied(course, completed) {</p>
<p class="p1"><span class="Apple-converted-space">  </span>return course.prereqs.every(prereq =&gt; prereqSatisfied(prereq, completed));</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function formatPrereqs(prereqs) {</p>
<p class="p1"><span class="Apple-converted-space">  </span>if (!prereqs.length) return "None";</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>return prereqs.map(p =&gt; {</p>
<p class="p1"><span class="Apple-converted-space">    </span>if (Array.isArray(p)) {</p>
<p class="p1"><span class="Apple-converted-space">      </span>return p.join(" or ");</p>
<p class="p1"><span class="Apple-converted-space">    </span>}</p>
<p class="p1"><span class="Apple-converted-space">    </span>return p;</p>
<p class="p1"><span class="Apple-converted-space">  </span>}).join(", ");</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function getCourseStatus(courseCode, course, completed) {</p>
<p class="p1"><span class="Apple-converted-space">  </span>if (completed.has(courseCode)) {</p>
<p class="p1"><span class="Apple-converted-space">    </span>return "completed";</p>
<p class="p1"><span class="Apple-converted-space">  </span>}</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>if (allPrereqsSatisfied(course, completed)) {</p>
<p class="p1"><span class="Apple-converted-space">    </span>return "available";</p>
<p class="p1"><span class="Apple-converted-space">  </span>}</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>return "locked";</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function loadMajor() {</p>
<p class="p1"><span class="Apple-converted-space">  </span>renderCheckboxes();</p>
<p class="p1"><span class="Apple-converted-space">  </span>renderGraph();</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function renderCheckboxes() {</p>
<p class="p1"><span class="Apple-converted-space">  </span>const major = getSelectedMajor();</p>
<p class="p1"><span class="Apple-converted-space">  </span>const container = document.getElementById("courseCheckboxes");</p>
<p class="p1"><span class="Apple-converted-space">  </span>container.innerHTML = "";</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>Object.entries(major.courses).forEach(([code, course]) =&gt; {</p>
<p class="p1"><span class="Apple-converted-space">    </span>const div = document.createElement("label");</p>
<p class="p1"><span class="Apple-converted-space">    </span>div.className = "checkbox-item";</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">    </span>div.innerHTML = `</p>
<p class="p1"><span class="Apple-converted-space">      </span>&lt;input type="checkbox" class="completed-check" value="${code}" onchange="renderGraph()"&gt;</p>
<p class="p1"><span class="Apple-converted-space">      </span>&lt;strong&gt;${code}&lt;/strong&gt;&lt;br&gt;</p>
<p class="p1"><span class="Apple-converted-space">      </span>&lt;span style="font-size:12px;color:#667085;"&gt;${course.title}&lt;/span&gt;</p>
<p class="p1"><span class="Apple-converted-space">    </span>`;</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">    </span>container.appendChild(div);</p>
<p class="p1"><span class="Apple-converted-space">  </span>});</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function renderGraph() {</p>
<p class="p1"><span class="Apple-converted-space">  </span>const major = getSelectedMajor();</p>
<p class="p1"><span class="Apple-converted-space">  </span>const completed = getCompletedCourses();</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>const graph = document.getElementById("graph");</p>
<p class="p1"><span class="Apple-converted-space">  </span>graph.innerHTML = "";</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>major.layout.forEach(levelCourses =&gt; {</p>
<p class="p1"><span class="Apple-converted-space">    </span>const levelDiv = document.createElement("div");</p>
<p class="p1"><span class="Apple-converted-space">    </span>levelDiv.className = "level";</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">    </span>levelCourses.forEach(code =&gt; {</p>
<p class="p1"><span class="Apple-converted-space">      </span>const course = major.courses[code];</p>
<p class="p1"><span class="Apple-converted-space">      </span>if (!course) return;</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">      </span>const status = getCourseStatus(code, course, completed);</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">      </span>const courseDiv = document.createElement("div");</p>
<p class="p1"><span class="Apple-converted-space">      </span>courseDiv.className = `course ${status}`;</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">      </span>courseDiv.innerHTML = `</p>
<p class="p1"><span class="Apple-converted-space">        </span>&lt;div class="course-code"&gt;${code}&lt;/div&gt;</p>
<p class="p1"><span class="Apple-converted-space">        </span>&lt;div class="course-title"&gt;${course.title}&lt;/div&gt;</p>
<p class="p1"><span class="Apple-converted-space">        </span>&lt;div class="course-prereq"&gt;Prereqs: ${formatPrereqs(course.prereqs)}&lt;/div&gt;</p>
<p class="p1"><span class="Apple-converted-space">      </span>`;</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">      </span>levelDiv.appendChild(courseDiv);</p>
<p class="p1"><span class="Apple-converted-space">    </span>});</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">    </span>graph.appendChild(levelDiv);</p>
<p class="p1"><span class="Apple-converted-space">  </span>});</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>renderSummary();</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function renderSummary() {</p>
<p class="p1"><span class="Apple-converted-space">  </span>const major = getSelectedMajor();</p>
<p class="p1"><span class="Apple-converted-space">  </span>const completed = getCompletedCourses();</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>const totalCourses = Object.keys(major.courses).length;</p>
<p class="p1"><span class="Apple-converted-space">  </span>const completedCount = completed.size;</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>const available = [];</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>Object.entries(major.courses).forEach(([code, course]) =&gt; {</p>
<p class="p1"><span class="Apple-converted-space">    </span>if (!completed.has(code) &amp;&amp; allPrereqsSatisfied(course, completed)) {</p>
<p class="p1"><span class="Apple-converted-space">      </span>available.push(code);</p>
<p class="p1"><span class="Apple-converted-space">    </span>}</p>
<p class="p1"><span class="Apple-converted-space">  </span>});</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>const summary = document.getElementById("summary");</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">  </span>summary.innerHTML = `</p>
<p class="p1"><span class="Apple-converted-space">    </span>&lt;strong&gt;Major:&lt;/strong&gt; ${major.name}&lt;br&gt;</p>
<p class="p1"><span class="Apple-converted-space">    </span>&lt;strong&gt;Completed:&lt;/strong&gt; ${completedCount} of ${totalCourses} courses&lt;br&gt;</p>
<p class="p1"><span class="Apple-converted-space">    </span>&lt;strong&gt;Available next:&lt;/strong&gt;</p>
<p class="p1"><span class="Apple-converted-space">    </span>&lt;span class="next-list"&gt;${available.length ? available.join(", ") : "None"}&lt;/span&gt;</p>
<p class="p1"><span class="Apple-converted-space">  </span>`;</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">function clearCompleted() {</p>
<p class="p1"><span class="Apple-converted-space">  </span>document.querySelectorAll(".completed-check").forEach(cb =&gt; {</p>
<p class="p1"><span class="Apple-converted-space">    </span>cb.checked = false;</p>
<p class="p1"><span class="Apple-converted-space">  </span>});</p>
<p class="p1"><span class="Apple-converted-space">  </span>renderGraph();</p>
<p class="p1">}</p>
<p class="p2"><br></p>
<p class="p1">loadMajor();</p>
<p class="p1">&lt;/script&gt;</p>
<p class="p2"><br></p>
<p class="p1">&lt;/body&gt;</p>
<p class="p1">&lt;/html&gt;</p>
</body>
</html>
